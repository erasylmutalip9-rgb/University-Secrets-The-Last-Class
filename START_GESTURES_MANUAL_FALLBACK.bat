@echo off
chcp 65001 >nul
cd /d "%~dp0"
setlocal
set "GAME_PYTHON=python"
python -c "import sys; sys.exit(sys.version_info < (3, 11))" >nul 2>&1
if errorlevel 1 (
  set "GAME_PYTHON=py -3"
  py -3 -c "import sys; sys.exit(sys.version_info < (3, 11))" >nul 2>&1
  if errorlevel 1 (
    echo ERROR: Install Python 3.11 or newer and add it to PATH.
    pause
    exit /b 1
  )
)
echo ==================================================
echo   FALLBACK MODE: KEYBOARD SIMULATION - NOT AI
 echo ==================================================
echo Use only when webcam is unavailable.
echo Manual input does NOT satisfy camera/gesture AI requirement.
%GAME_PYTHON% ai_service\gesture_service.py --manual
pause
